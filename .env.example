# -----------------------------------------------------------------------------
# GIA PHẢ OS - MẪU BIẾN MÔI TRƯỜNG CẤU HÌNH (ENVIRONMENT VARIABLES)
# -----------------------------------------------------------------------------
# Hướng dẫn:
# 1. Chép (copy) file này thành ".env.local"
# 2. Điền các giá trị thực tế tương ứng với dự án Supabase của bạn

# Tên của ứng dụng web được hiển thị cho người dùng
NEXT_PUBLIC_SITE_NAME="Gia Phả OS"

# URL của project Supabase (Lấy từ Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Khóa Public (Lấy từ Settings > API > Project API keys > anon / public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-anon-or-public-key"

# (Tuỳ chọn) Email và mật khẩu mẫu cho trang demo
NEXT_PUBLIC_EXAMPLE_EMAIL=""
NEXT_PUBLIC_EXAMPLE_PASSWORD=""

# (Tuỳ chọn) Domain cho chế độ demo
NEXT_PUBLIC_DEMO_DOMAIN="giapha-os.homielab.com"

# (Tuỳ chọn) API Key cho chatbot AI (DeepSeek)
DEEPSEEK_API_KEY=""

# (Tuỳ chọn) Service Role Key cho Supabase (bypass RLS - CHỈ dùng ở server)
SUPABASE_SERVICE_ROLE_KEY=""

# (Tuỳ chọn) Webhook Secret cho API chat
WEBHOOK_SECRET=""

# (Tuỳ chọn) Vercel Blob Storage Token
BLOB_READ_WRITE_TOKEN=""
